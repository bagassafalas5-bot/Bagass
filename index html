<style>
:root {
  --bg: #080b10;
  --panel: #111720;
  --gold: #d9b46a;
  --white: #f8f8f8;
  --muted: #a8b0bd;
  --line: rgba(255,255,255,.12);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--white);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  width: min(1150px, 90%);
  margin: auto;
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(8,11,16,.95);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}

.nav {
  min-height: 75px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.logo {
  font-size: 19px;
  font-weight: 800;
  letter-spacing: 2px;
}

.logo span {
  color: var(--gold);
}

nav {
  display: flex;
  align-items: center;
  gap: 25px;
}

nav a {
  font-size: 13px;
  color: #ddd;
  transition: .2s;
}

nav a:hover {
  color: var(--gold);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 20px;
  border-radius: 5px;
  font-size: 13px;
  font-weight: bold;
  border: 1px solid var(--gold);
  transition: .25s;
  cursor: pointer;
}

.btn-gold {
  background: var(--gold);
  color: #111;
}

.btn-gold:hover {
  background: #f0d18e;
  transform: translateY(-2px);
}

.btn-outline {
  color: var(--gold);
  background: transparent;
}

.btn-outline:hover {
  background: var(--gold);
  color: #111;
}

.hero {
  padding: 48px 0 70px;
  background:
    radial-gradient(ellipse at top right, #253344 0%, transparent 55%),
    linear-gradient(135deg, #080b10, #101925);
}

.hero-label {
  color: var(--gold);
  letter-spacing: 4px;
  font-size: 11px;
  font-weight: bold;
  margin-bottom: 17px;
}

.hero h1 {
  font-size: clamp(34px, 6vw, 65px);
  line-height: 1.1;
  letter-spacing: -2px;
  max-width: 800px;
  margin-bottom: 20px;
}

.hero h1 span {
  color: var(--gold);
}

.hero p {
  color: var(--muted);
  max-width: 650px;
  font-size: 15px;
  margin-bottom: 27px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.banner {
  margin-top: 42px;
  overflow: hidden;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: #fff;
}

.banner img {
  width: 100%;
  display: block;
  height: auto;
}

section {
  padding: 75px 0;
}

.section-tag {
  color: var(--gold);
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: bold;
  margin-bottom: 10px;
}

.section-title {
  font-size: clamp(27px, 4vw, 39px);
  line-height: 1.2;
  margin-bottom: 12px;
}

.section-desc {
  color: var(--muted);
  font-size: 14px;
  max-width: 650px;
  margin-bottom: 35px;
}

.products {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
  transition: .25s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: rgba(217,180,106,.6);
}

.car-placeholder {
  height: 190px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background:
    radial-gradient(ellipse at center, #293849, #111720 70%);
  color: var(--gold);
}

.car-placeholder strong {
  font-size: 34px;
  letter-spacing: 2px;
}

.car-placeholder span {
  color: #aeb8c5;
  font-size: 11px;
  letter-spacing: 3px;
}

.card-content {
  padding: 23px;
}

.badge {
  display: inline-block;
  color: var(--gold);
  background: rgba(217,180,106,.10);
  border: 1px solid rgba(217,180,106,.3);
  padding: 5px 9px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: bold;
  margin-bottom: 12px;
}

.card h3 {
  font-size: 22px;
  margin-bottom: 5px;
}

.subtitle {
  color: var(--muted);
  font-size: 12px;
  margin-bottom: 15px;
}

.price-label {
  color: var(--muted);
  font-size: 11px;
}

.price {
  font-size: 22px;
  font-weight: 800;
  color: var(--gold);
  margin-bottom: 17px;
}

.features {
  list-style: none;
  border-top: 1px solid var(--line);
  padding-top: 14px;
  margin-bottom: 20px;
}

.features li {
  font-size: 12px;
  color: #d0d5dc;
  margin: 8px 0;
}

.features li::before {
  content: "✓";
  color: var(--gold);
  margin-right: 9px;
  font-weight: bold;
}

.card .btn {
  width: 100%;
}

.note {
  font-size: 11px;
  color: var(--muted);
  margin-top: 20px;
}

.finance {
  background: #0e141d;
}

.finance-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.finance-card {
  border: 1px solid var(--line);
  padding: 25px;
  border-radius: 8px;
  background: #131c28;
}

.finance-card h3 {
  font-size: 20px;
  margin-bottom: 20px;
}

.finance-card p {
  font-size: 12px;
  color: var(--muted);
}

.finance-card .amount {
  font-size: 25px;
  font-weight: bold;
  color: var(--gold);
  margin-bottom: 13px;
}

.finance-card .installment {
  font-size: 20px;
  font-weight: bold;
  color: white;
  margin-bottom: 20px;
}

.finance-card .btn {
  width: 100%;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 50px;
}

.profile-box {
  min-height: 330px;
  border: 1px solid var(--line);
  border-radius: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  text-align: center;
